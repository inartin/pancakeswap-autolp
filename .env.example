# ==========================================
# REQUIRED
# ==========================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your numeric Telegram user ID (from @userinfobot)
TELEGRAM_ADMIN_ID=your_telegram_user_id_here

# Solana RPC endpoint (Helius free tier recommended: https://www.helius.dev/)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Master password used to encrypt wallet private keys at rest.
# Auto-generated by `pnpm run setup`. Keep secret - if lost, encrypted keys
# are unrecoverable.
MASTER_PASSWORD=

# ==========================================
# RUNTIME
# ==========================================

# development | production
NODE_ENV=development

# info | debug
LOG_LEVEL=info

# ==========================================
# PRODUCTION DATABASE
# Required when NODE_ENV=production (used as cloud backup for wallets + TOS)
# ==========================================

# POSTGRES_URI=postgresql://user:pass@host/db

# ==========================================
# RECOMMENDED API KEYS
# ==========================================

# Jupiter API key (https://portal.jup.ag/) - prevents swap rate limits / 504s
JUP_API=

# Jupiter plan tier: free | paid (default: paid)
JUP_PLAN=free

# Moralis API key - used for token metadata lookups (https://moralis.io/)
MORALIS_API_KEY=

# ==========================================
# JUPITER (Optional)
# ==========================================

# JUPITER_API_BASE_URL=https://api.jup.ag/swap/v1
# JUPITER_ULTRA_API_BASE_URL=https://api.jup.ag/ultra/v1

# Priority fee for Jupiter swap transactions in microlamports.
# Default: 1000000 (~0.001 SOL). Hard cap: 30000000 (~0.012 SOL).
# JUPITER_PRIORITY_FEE_LAMPORTS=1000000

# ==========================================
# TRANSACTION TUNING (Optional)
# ==========================================

# Retries when parsing transaction metadata (default: 3)
# TX_METADATA_PARSE_MAX_RETRIES=3

# Delay between metadata parse retries in ms (default: 1000)
# TX_METADATA_PARSE_RETRY_DELAY_MS=1000

# Use Helius SWQOS for higher transaction success rate (default: true)
# USE_SWQOS=true

# ==========================================
# REDIS CACHE (Optional)
# Speeds up static lookups (decimals, token programs, metadata)
# ==========================================

USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ==========================================
# CLAIM SPLIT (Optional)
# ==========================================

# Fraction (0-1) of claimed rewards transferred to the claim address.
# Remainder stays in the active wallet. Default: 0.75
# SPLIT_CLAIM_PERCENT=0.75

# ==========================================
# REBALANCE TOP-UP (Optional)
# ==========================================

# Auto top-up underfunded sides during rebalance (default: true)
# REBALANCE_TOP_UP_ENABLED=true

# Minimum utilization ratio that skips top-up (default: 0.5)
# REBALANCE_TOP_UP_MIN_UTILIZATION=0.5

# Ignore residual balances below this USD value (default: 1)
# REBALANCE_TOP_UP_DUST_USD=1

# ==========================================
# ETHEREUM (Optional - read-only Uniswap views)
# ==========================================

# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
