{
  "name": "pancakeswap-position-reader",
  "version": "0.4",
  "description": "Read PancakeSwap AMM v3 position data",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-env.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "dashboard": "node playground/dashboard-server.js",
    "db:push": "echo '⚠️  Do not run db:generate on production! Only apply migrations via git pull + restart.'",
    "temp": "vcgencmd measure_temp",
    "temp-live": "watch -n 2 vcgencmd measure_temp",
    "system": "vcgencmd measure_temp && echo \"$(($(vcgencmd measure_clock arm | awk -F'=' '{print $2}') / 1000000)) MHz\" && vcgencmd measure_volts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@meteora-ag/dlmm": "^1.9.14",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.87.6",
    "axios": "^1.12.2",
    "better-sqlite3": "^12.4.1",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "dotenv": "^16.3.1",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.6",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "ioredis": "^5.4.1",
    "node-telegram-bot-api": "^0.66.0",
    "postgres": "^3.4.7",
    "sodium-native": "^5.0.9",
    "ws": "^8.18.3"
  },
  "keywords": [
    "solana",
    "pancakeswap",
    "amm",
    "defi",
    "position"
  ],
  "author": "Your Name",
  "license": "MIT"
}
